{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node miniapp/build.mjs",
  "outputDirectory": "miniapp/dist",
  "cleanUrls": true,
  "regions": ["arn1"],
  "functions": {
    "api/telegram.mjs": { "includeFiles": "{data/questions/*.json,data/theory/**/*.json}" },
    "api/daily.mjs": { "includeFiles": "{data/questions/*.json,data/theory/**/*.json}", "maxDuration": 300 },
    "api/mcp.mjs": { "includeFiles": "{data/questions/*.json,data/theory/**/*.json,docs/design/figures.js}" }
  },
  "crons": [{ "path": "/api/daily", "schedule": "0 9 * * *" }],
  "redirects": [
    { "source": "/regatta", "destination": "https://regatta.rycrentals.com/", "permanent": true }
  ],
  "headers": [
    { "source": "/h/(.*)", "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/fonts/(.*).woff2", "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/data/(.*)", "headers": [{ "key": "cache-control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "iyt-test.vercel.app" }], "headers": [{ "key": "x-robots-tag", "value": "noindex" }] }
  ]
}
