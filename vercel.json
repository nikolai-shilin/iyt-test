{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node miniapp/build.mjs",
  "outputDirectory": "miniapp/dist",
  "cleanUrls": true,
  "functions": {
    "api/telegram.mjs": { "includeFiles": "data/questions/*.json" },
    "api/daily.mjs": { "includeFiles": "data/questions/*.json", "maxDuration": 300 }
  },
  "crons": [{ "path": "/api/daily", "schedule": "0 9 * * *" }],
  "headers": [
    { "source": "/data/(.*)", "headers": [{ "key": "cache-control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
