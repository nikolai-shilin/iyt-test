# Copy to .env.local and fill in. Never commit .env.local.
TELEGRAM_BOT_TOKEN=123456789:replace-with-the-token-from-BotFather
# Optional: mini app URL for the bot's menu button (set once the app is deployed)
WEBAPP_URL=
# Random string Telegram sends with each webhook call; set the same value on Vercel (openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=
# Supabase project iyt-test (docs/data-model.md). The secret key is server-only (data/load.mjs, and the bot on Vercel,
# which keeps users and their daily-question switch) — never ship it to the app.
SUPABASE_URL=https://xpdhkahgvusuicynssxq.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_WKUQdLYP62nam72_h4p5QA_Sz8nxD_Y
SUPABASE_SECRET_KEY=
# Question of the day (bot/daily.mjs). Vercel sends CRON_SECRET with each cron call; set it on Vercel (openssl rand -hex 32).
CRON_SECRET=
# Set to off to stop the morning send for everyone (users' own switches stay as they are)
DAILY_QUESTION=on
